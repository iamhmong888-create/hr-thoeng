rules_version = '2';
// กฎความปลอดภัย Firestore — ระบบงานบุคลากร
// คัดลอกทั้งหมดไปวางที่ Firebase Console > Firestore Database > Rules แล้วกด Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasUser() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return hasUser() && me().role == 'admin'; }
    function mySid() { return hasUser() ? me().staffId : '__none__'; }
    // ใช้ได้ครั้งเดียวตอนติดตั้ง (ยังไม่มี config/setup และเอกสารนี้ถูกสร้างใน batch เดียวกัน)
    function bootstrapping() {
      return signedIn() && !exists(/databases/$(database)/documents/config/setup) && existsAfter(/databases/$(database)/documents/config/setup);
    }

    match /config/setup {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/config/setup)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    match /config/meta {
      allow read: if hasUser();
      allow write: if isAdmin() || bootstrapping();
    }

    // ชื่อผู้ใช้ → อีเมลเข้าสู่ระบบ (อ่านได้ทีละชื่อเท่านั้น ดูรายการทั้งหมดไม่ได้)
    match /logins/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin() || bootstrapping();
      // ครูเปลี่ยนชื่อตนเอง: สร้างชื่อใหม่ (ที่ยังไม่มีคนใช้) และลบชื่อเดิมได้ เฉพาะที่ผูกกับอีเมลของตนเอง
      allow create: if hasUser() && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if hasUser() && resource.data.email == request.auth.token.email;
    }

    // บัญชี → รหัสบุคลากร และสิทธิ์
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (bootstrapping() && request.auth.uid == uid && request.resource.data.role == 'admin');
      allow update, delete: if isAdmin();
    }

    // ข้อมูลบุคลากร: ครูอ่าน/แก้ได้เฉพาะของตนเอง และแก้ได้เฉพาะบางช่อง
    match /staff/{sid} {
      allow read: if isAdmin() || mySid() == sid;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        mySid() == sid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'prefix', 'firstName', 'lastName', 'position', 'citizenId', 'phone', 'email', 'address',
          'birthDay', 'birthMonth', 'birthYear', 'education', 'major',
          'scoutQual', 'scoutType', 'scoutPosition', 'scoutFee', 'redCrossQual', 'redCrossDate', 'salary', 'insignia',
          'pwChanged', 'updatedAt'])
        && (!('pwChanged' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.pwChanged == true)
      );
    }

    // รายการพัฒนาตนเอง: เจ้าของเท่านั้นที่เพิ่ม/แก้/ลบได้ ผู้บริหารดูได้ทุกคนและบันทึกผลการตรวจได้อย่างเดียว
    match /records/{rid} {
      function owner() { return hasUser() && resource.data.staffId == mySid(); }
      function reviewCleared() {
        return request.resource.data.get('review', '') == '' && request.resource.data.get('reviewBy', '') == '';
      }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow read: if isAdmin() || owner();
      allow create: if hasUser() && request.resource.data.staffId is string && request.resource.data.staffId != ''
        && request.resource.data.staffId == mySid() && reviewCleared();
      allow update: if (owner() && request.resource.data.staffId == mySid() && reviewCleared())
        || (isAdmin() && resource.data.staffId != mySid()
            && changed().hasOnly(['review', 'reviewNote', 'reviewBy', 'reviewAt', 'projectName']))
        || (isAdmin() && changed().hasOnly(['projectName']));
      // ผู้บริหารลบได้เฉพาะตอนลบบุคลากรคนนั้นออกจากระบบ (ลบพร้อมกันใน batch เดียว)
      allow delete: if owner()
        || (isAdmin() && !existsAfter(/databases/$(database)/documents/staff/$(resource.data.staffId)));
    }

    // การลา: ครูอ่านได้เฉพาะของตนเอง (ดูอย่างเดียว) บันทึก/แก้ไข/ลบได้เฉพาะผู้บริหาร/ผู้ดูแลระบบ
    match /leaves/{lid} {
      allow read: if isAdmin() || (hasUser() && resource.data.staffId == mySid());
      allow write: if isAdmin();
    }
    // วันลาพักผ่อนสะสม/สิทธิ์ต่อปี: ครูอ่านได้เฉพาะของตนเอง บันทึกได้เฉพาะผู้บริหาร/ผู้ดูแลระบบ
    match /leaveBalances/{bid} {
      allow read: if isAdmin() || (hasUser() && resource.data.staffId == mySid());
      allow write: if isAdmin();
    }

    // รูปหลักฐาน (แยกเอกสาร เพื่อให้โหลดรายการได้เร็ว)
    match /photos/{rid} {
      allow read: if isAdmin() || (hasUser() && resource.data.staffId == mySid());
      allow create: if hasUser() && request.resource.data.staffId == mySid();
      allow update: if hasUser() && resource.data.staffId == mySid() && request.resource.data.staffId == mySid();
      allow delete: if (hasUser() && (resource == null || resource.data.staffId == mySid()))
        || (isAdmin() && (resource == null || !existsAfter(/databases/$(database)/documents/staff/$(resource.data.staffId))));
    }
  }
}
